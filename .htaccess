# Configuración de Apache para el Sistema de Inventario

# Habilitar rewrite engine
RewriteEngine On
AddType application/manifest+json .webmanifest

# El back, las vistas y los metadatos de Git no se abren por URL.
RewriteRule ^back/ - [F,L]
RewriteRule ^front/views/ - [F,L]
RewriteRule ^docs/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^mcp/ - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule ^\.cursor - [F,L]

# Redirigir a index.php si el archivo no existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Proteger archivos sensibles
<FilesMatch "\.(sql|log|ini|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

